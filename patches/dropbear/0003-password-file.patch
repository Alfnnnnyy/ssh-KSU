+static int rmsh_unhex(const char *hex, unsigned char *out, size_t outmax) {
+	size_t n = 0;
+	while (hex[0] != '\0' && hex[1] != '\0') {
+		int hi = rmsh_hexval((unsigned char)hex[0]);
+		int lo = rmsh_hexval((unsigned char)hex[1]);
+		if (hi < 0 || lo < 0 || n >= outmax) {
+			return -1;
+		}
+		out[n++] = (unsigned char)((hi << 4) | lo);
