+static int rmsh_pbkdf2_sha256(const unsigned char *pw, unsigned long pwlen,
+		const unsigned char *salt, unsigned long saltlen,
+		int iter, unsigned char out[RMSH_DK_LEN]) {
+	int h = find_hash("sha256");
+	unsigned char U[RMSH_DK_LEN], T[RMSH_DK_LEN], *blk;
+	unsigned long ul, blen;
+	int i, j;
+
+	if (h < 0 || iter < 1) return -1;
+	blen = saltlen + 4;
+	blk = (unsigned char *)m_malloc(blen);
+	memcpy(blk, salt, saltlen);
+	blk[saltlen] = 0; blk[saltlen + 1] = 0;
+	blk[saltlen + 2] = 0; blk[saltlen + 3] = 1;
+	ul = sizeof(U);
+	if (hmac_memory(h, pw, pwlen, blk, blen, U, &ul) != CRYPT_OK) { m_free(blk); return -1; }
+	m_free(blk);
+	memcpy(T, U, RMSH_DK_LEN);
+	for (i = 1; i < iter; i++) {
+		unsigned char Un[RMSH_DK_LEN]; unsigned long nl = sizeof(Un);
+		if (hmac_memory(h, pw, pwlen, U, RMSH_DK_LEN, Un, &nl) != CRYPT_OK) return -1;
+		memcpy(U, Un, RMSH_DK_LEN);
+		for (j = 0; j < RMSH_DK_LEN; j++) T[j] ^= U[j];
+	}
