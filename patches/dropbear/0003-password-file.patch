+static int rmsh_password_ok(const char *user,
+		const unsigned char *password, unsigned int passwordlen) {
+	const char *path = getenv("DROPBEAR_PASSWD_FILE");
+	FILE *f;
+	char line[RMSH_MAX_LINE];
+	int matched = 0;
+
+	if (path == NULL || *path == '\0') {
+		return 0;
+	}
+	f = fopen(path, "r");
+	if (f == NULL) {
+		return 0;
+	}
+
+	while (fgets(line, sizeof(line), f) != NULL) {
+		char *nl, *colon, *spec, *p_iter, *p_salt, *p_hash;
+		unsigned char salt[RMSH_MAX_HASH];
+		unsigned char want[RMSH_MAX_HASH];
+		unsigned char got[RMSH_DK_LEN];
+		int saltlen, wantlen, iter;
+
+		if ((nl = strchr(line, '\n')) != NULL) *nl = '\0';
+		if ((nl = strchr(line, '\r')) != NULL) *nl = '\0';
+		if (line[0] == '\0' || line[0] == '#') continue;
+
+		colon = strchr(line, ':');
+		if (colon == NULL) continue;
+		*colon = '\0';
+		if (strcmp(line, user) != 0) continue;
+
+		spec = colon + 1;
+		if (strncmp(spec, "pbkdf2-sha256$", 14) != 0) continue;
+		p_iter = spec + 14;
+		if ((p_salt = strchr(p_iter, '$')) == NULL) continue;
+		*p_salt++ = '\0';
+		if ((p_hash = strchr(p_salt, '$')) == NULL) continue;
+		*p_hash++ = '\0';
+
+		iter = atoi(p_iter);
+		if (iter < 1) continue;
+		saltlen = rmsh_unhex(p_salt, salt, sizeof(salt));
+		wantlen = rmsh_unhex(p_hash, want, sizeof(want));
+		if (saltlen <= 0 || wantlen != RMSH_DK_LEN) continue;
+
+		if (rmsh_pbkdf2_sha256(password, passwordlen, salt, (unsigned long)saltlen,
+				iter, got) == 0
+				&& constant_time_memcmp(got, want, RMSH_DK_LEN) == 0) {
+			matched = 1;
+		}
+		m_burn(got, sizeof(got));
+		if (matched) break;
+	}
+
+	fclose(f);
+	return matched;
 }
 
